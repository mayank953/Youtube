# Copy this file to ".env" (same folder) and add AT LEAST ONE key below.
# settings.py picks the first available provider in this priority order:
#   1. Anthropic   2. OpenAI   3. OpenRouter (free tier)

ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here

# FREE fallback — no paid key required. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key-here

# Optional overrides (sensible defaults already set in settings.py)
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_MODEL=gpt-4o
# OPENROUTER_FREE_MODEL=meta-llama/llama-3.1-8b-instruct:free
# MAX_TOKENS=1024
# DEBUG=true
